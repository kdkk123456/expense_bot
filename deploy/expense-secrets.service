[Unit]
Description=Fetch Expense Bot Secrets from AWS SSM Parameter Store
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /run/expense-bot
ExecStart=/opt/expense-bot/deploy/fetch-secrets.sh
RemainAfterExit=true

# Allow time for network to be fully ready
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
